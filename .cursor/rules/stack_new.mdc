    app/router.tsx           # /, /product/:slug, /admin
    app/providers/theme.tsx  # class .dark / .light на <html>
    styles/globals.css       # ТОКЕНЫ — единственный источник цветов
    styles/fonts.css
    pages/home/              # витрина desktop/mobile
    pages/product/           # PDP (выбор варианта/размера/соусов/добавок)
